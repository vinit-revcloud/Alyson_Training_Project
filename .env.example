# Neon Auth + Data API (browser client — must be set at BUILD time)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.region.aws.neon.tech/neondb/rest/v1

# Direct Postgres (migrations, server SQL — bypasses RLS)
# Production on Vercel: use Neon *connection pooler* URL (-pooler host)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Serverless pool size per instance (default 2 on Vercel, 5 locally)
PG_POOL_MAX=2

# Vercel Blob — optional read fallback when migrating; not needed if using S3 only
# BLOB_READ_WRITE_TOKEN=

# --- Local dev: upload class PDFs to S3 (recommended) ---
# ASSET_STORAGE_BACKEND=s3 forces S3 even when NODE_ENV is not production
ASSET_STORAGE_BACKEND=s3
S3_ASSETS_BUCKET=alyson-training-media
S3_ASSETS_REGION=us-west-2
# Optional prefix when sharing one bucket across environments
# S3_ASSETS_PREFIX=dev
# Verify: npm run assets:test-s3
# Run app: npm run dev → http://localhost:5173 → Classes → upload a PDF

# Optional observability
SENTRY_DSN=
AI_MONTHLY_BUDGET_USD=100

# Server runtime fallbacks (required for Docker/self-hosted at RUNTIME — copy VITE_* values here)
NEON_AUTH_URL=
NEON_DATA_API_URL=

# App — set APP_BASE_URL to your public HTTPS origin in production
# On Vercel: https://your-project.vercel.app or your custom domain (required for email links)
APP_BASE_URL=http://localhost:5173
CRON_SECRET=generate-a-long-random-secret

# Optional: separate secret for asset URL HMAC (defaults to CRON_SECRET)
# ASSET_SIGNING_SECRET=

# Initial workspace admins (comma-separated); leave empty in production after bootstrap
BOOTSTRAP_ADMIN_EMAILS=admin@cintara.ai

# AI — DeepSeek is tried first; OpenRouter is used as fallback (401/402/missing key)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# AWS — SES + S3 + optional Lambda workflow (default region: us-west-2 Oregon)
# Verify SES identity in the same region, e.g. training.group@cintara.ai in us-west-2
AWS_REGION=us-west-2
SES_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_NAME=Cintara Training
SES_CONFIGURATION_SET=alyson-training

# Step Functions assignment workflow (optional — same region as Lambda)
EMAIL_WORKFLOW_LAMBDA_ARN=arn:aws:lambda:us-west-2:ACCOUNT_ID:function:alyson-training-email-send-lambda
EMAIL_WORKFLOW_LAMBDA_REGION=us-west-2
# Drain email queue immediately after enqueue — local dev only (must be unset or 0 in production)
# EMAIL_AUTO_PROCESS=1

# Set by host in production
# NODE_ENV=production
# PORT=4173
# HOST=0.0.0.0
