# Neon Auth + Data API (browser client — must be set at BUILD time)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.region.aws.neon.tech/neondb/rest/v1

# Direct Postgres (migrations, server SQL — bypasses RLS)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Server runtime fallbacks (optional — VITE_* are baked in at build time)
# NEON_AUTH_URL=
# NEON_DATA_API_URL=

# App — set APP_BASE_URL to your public HTTPS origin in production
# On Vercel: https://your-project.vercel.app or your custom domain (required for email links)
APP_BASE_URL=http://localhost:5173
CRON_SECRET=generate-a-long-random-secret

# Optional: separate secret for asset URL HMAC (defaults to CRON_SECRET)
# ASSET_SIGNING_SECRET=

# Initial workspace admins (comma-separated); leave empty in production after bootstrap
BOOTSTRAP_ADMIN_EMAILS=admin@cintara.ai

# AI — DeepSeek is tried first; OpenRouter is used as fallback (401/402/missing key)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# AWS SES (training.group@cintara.ai)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_NAME=Cintara Training
SES_CONFIGURATION_SET=alyson-training

# Step Functions workflow trigger (Lambda in us-west-2)
EMAIL_WORKFLOW_LAMBDA_ARN=arn:aws:lambda:us-west-2:ACCOUNT_ID:function:alyson-training-email-send-lambda
# Optional override if ARN parsing fails
# EMAIL_WORKFLOW_LAMBDA_REGION=us-west-2

# Drain email queue immediately after enqueue — local dev only (unset or 0 in production)
EMAIL_AUTO_PROCESS=1

# Set by host in production
# NODE_ENV=production
# PORT=4173
# HOST=0.0.0.0
